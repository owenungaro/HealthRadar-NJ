<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HealthRadar NJ Dashboard</title>
    <link rel="stylesheet" href="/public/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  </head>
  <body>
    <div class="logo-container">
      <img src="/public/images/healthradar_logo.svg" alt="HealthRadar Logo" class="logo">
    </div>

    <header class="dashboard-header">
      <h1>Welcome to the HealthRadar NJ Dashboard</h1>
      <form action="/auth/logout" method="POST" class="logout-form">
        <button type="submit" class="logout-button">Logout</button>
      </form>
    </header>

    <main class="dashboard-container">
      <section class="feature-buttons">
        <div class="feature-card">
          <a href="/facilities" class="card-link">
            <div class="card">
              <i class="fas fa-hospital-alt"></i>
              <h3>Explore Facilities</h3>
            </div>
          </a>
        </div>

        <div class="feature-card">
          <a href="/reviews" class="card-link">
            <div class="card">
              <i class="fas fa-star"></i>
              <h3>See Reviews</h3>
            </div>
          </a>
        </div>

        <div class="feature-card">
          <a href="/user-profile" class="card-link">
            <div class="card">
              <i class="fas fa-user-circle"></i>
              <h3>User Profile</h3>
            </div>
          </a>
        </div>

        <div class="feature-card">
          <a href="/analytics" class="card-link">
            <div class="card">
              <i class="fas fa-chart-line"></i>
              <h3>Analytics Dashboard</h3>
            </div>
          </a>
        </div>

        <div class="feature-card">
          <a href="/emergency" class="card-link">
            <div class="card">
              <i class="fas fa-ambulance"></i>
              <h3>Find Emergency Centers</h3>
            </div>
          </a>
        </div>
      </section>
    </main>

    <footer>
      <p>&copy; 2025 HealthRadar NJ. All rights reserved.</p>
    </footer>
  </body>
</html>