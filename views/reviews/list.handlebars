<div class="facilities-header">
  <h2>{{translateText "My Reviews"}}</h2>

  <div class="facilities-actions">
    <a href="/dashboard" class="back-to-dashboard-button">
      {{translateText "Back to Dashboard"}}
      </a>
  </div>
</div>
<div class="logo-container">
  <img src="/public/images/healthradar_logo.svg" alt="HealthRadar Logo" class="logo">
</div>
<section class="reviews-section">

  {{#if reviews.length}}
    {{#each reviews}}
      <div class="review-card">
        <p><strong>{{this.username}}</strong></p>
        <p>
          <strong>{{translateText "Facility"}}:</strong>
          <a href="/facilities/{{this.facilityId}}">{{this.facilityName}}</a>
        </p>

        <p>
          <strong>{{translateText "Rating"}}:</strong>
          {{#if this.rating}}
            {{this.rating}}
            / 5
          {{else}}
            <i>{{translateText "No rating provided"}}</i>
          {{/if}}
        </p>

        <p>{{this.review}}</p>
        <p><i>{{this.dateFormatted}}</i></p>
      </div>
      <hr />
    {{/each}}

  {{else}}
    <p><i>{{translateText "You haven't written any reviews yet"}}</i></p>
  {{/if}}

</section>