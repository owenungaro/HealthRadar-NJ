<div class="dashboard-header">
  <h1>{{translateText "Welcome to Facilities"}}</h1>
  {{#if user}}
    <div class="facilities-actions">
      <a href="/dashboard" class="back-to-dashboard-button">
    {{translateText "Back to Dashboard"}}
      </a>

      <form action="/auth/logout" method="POST" class="logout-form">
        <button type="submit" class="logout-button">{{translateText "Logout"}}</button>
      </form>
    </div>
  {{/if}}
</div>
<div class="logo-container">
  <img src="/public/images/healthradar_logo.svg" alt="HealthRadar Logo" class="logo">
</div>

<form id="facility-filters" class="facility-filters">
  <label>
    {{translateText "County"}}:
    <input type="text" name="county" id="county" value="{{filters.county}}" >
  </label>
  <label>
    {{translateText "City"}}:
    <input type="text" name="city" id="city" value="{{filters.city}}" >
  </label>
  <label>
    {{translateText "Type"}}:
    <input type="text" name="facilityType" id="facilityType" value="{{filters.facilityType}}" >
  </label>
  <label>
  {{translateText "License Status"}}:
  <select name="isActive" id="isActive">
    <option value="">{{translateText "All"}}</option> 
    <option value="true" {{#if filters.isActive}}{{#if (eq filters.isActive 'true')}} {{translateText "selected"}} {{/if}}{{/if}}>{{translateText "Active"}}</option>
    <option value="false" {{#if filters.isActive}}{{#if (eq filters.isActive 'false')}} {{translateText "selected"}} {{/if}}{{/if}}>{{translateText "Inactive"}}</option>
  </select>
</label>
  
  <button type="button" id="reset-filters">
    {{translateText "Reset Filters"}}
  </button>
</form>

<div id="facility-list-container"></div>


<script src="/public/js/AJAXfilter.js"></script>