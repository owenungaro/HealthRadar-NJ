<div class="dashboard-header">
  <h1>{{translateText "Welcome to Facilities"}}</h1>
  {{#if user}}
    <div class="facilities-actions">
      <a href="/dashboard" class="dashboard-link">
        <button class="back-to-dashboard-button">{{translateText "Back to Dashboard"}}</button>
      </a>

      <form action="/auth/logout" method="POST" class="logout-form">
        <button type="submit" class="logout-button">{{translateText "Logout"}}</button>
      </form>
    </div>
  {{/if}}
</div>
<div class="logo-container">
  <img src="/public/images/healthradar_logo.svg" alt="HealthRadar Logo" class="logo">
</div>

<!-- Filters Form -->
<form id="facility-filters" class="facility-filters">
  <label>
    {{translateText "County:"}}
    <input type="text" name="county" id="county" value="{{filters.county}}" />
  </label>
  <label>
    {{translateText "City:"}}
    <input type="text" name="city" id="city" value="{{filters.city}}" />
  </label>
  <label>
    {{translateText "Type:"}}
    <input type="text" name="facilityType" id="facilityType" value="{{filters.facilityType}}" />
  </label>
  <label>
  {{translateText "License Status:"}}
  <select name="isActive" id="isActive">
    <option value="">{{translateText "All"}}</option> <!-- When "All" is selected, it should be empty -->
    <option value="true" {{#if filters.isActive}}{{#if (eq filters.isActive 'true')}} {{translateText "selected"}} {{/if}}{{/if}}>{{translateText "Active"}}</option>
    <option value="false" {{#if filters.isActive}}{{#if (eq filters.isActive 'false')}} {{translateText "selected"}} {{/if}}{{/if}}>{{translateText "Inactive"}}</option>
  </select>
</label>
  
  <button type="submit">{{translateText "Filter"}}</button>
  
  <button type="button" id="reset-filters">
    {{translateText "Reset Filters"}}
  </button>
</form>


<div id="facility-list-container">
  {{#if facilities.length}}
    <div class="facility-list">
      {{#each facilities}}
        <div class="facility-card">
          <h3 class="facility-name">
            <a href="/facilities/{{this._id}}">{{this.licensedFacilityName}}</a>
          </h3>
          <p><strong>{{translateText "Type:"}}</strong> {{this.facilityType}}</p>
          <p><strong>{{translateText "Address:"}}</strong> {{this.address}}, {{this.city}}, {{this.county}} {{translateText "County"}}</p>
          <p><strong>{{translateText "Phone"}}:</strong> {{this.telephone}}</p>
          <p><strong>{{translateText "Email:"}}</strong> <a href="mailto:{{this.email}}">{{this.email}}</a></p>
          <p><strong>{{translateText "License Status:"}}</strong> 
            {{#if this.isActive}} 
              <span class="status-active">{{translateText "Active"}}</span>
            {{else}} 
              <span class="status-inactive">{{translateText "Inactive"}}</span>
            {{/if}}
          </p>
          <p><strong>{{translateText "Average Rating:"}}</strong> {{this.averageRating}} ({{this.totalReviews}} {{translateText "reviews"}})</p>
        </div>
      {{/each}}
    </div>
  {{else}}
    <p>{{translateText "No facilities found with these filters."}}</p>
  {{/if}}
</div>

<script src="/public/js/AJAXfilter.js"></script>