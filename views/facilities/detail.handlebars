<div class="facilities-header">
  <h2>{{facility.licensedFacilityName}}</h2>

  {{#if user}}
    <div class="facilities-actions">
      <a href="/dashboard" class="dashboard-link">{{translateText "Back to Dashboard"}}</a>

      <form action="/auth/logout" method="POST" class="logout-form">
        <button type="submit" class="logout-button">{{translateText "Logout"}}</button>
      </form>
    </div>
  {{/if}}
</div>

<p><strong>{{translateText "Type"}}:</strong> {{facility.facilityType}}</p>
<p><strong>{{translateText "Address"}}:</strong> {{facility.address}}, {{facility.city}}, {{facility.state}} {{facility.zipCode}}</p>
<p><strong>{{translateText "County"}}:</strong> {{facility.county}}</p>
<p><strong>{{translateText "Phone"}}:</strong> {{facility.telephone}}</p>
<p><strong>{{translateText "Email"}}:</strong> <a href="mailto:{{facility.email}}">{{facility.email}}</a></p>

<p><strong>{{translateText "License Expires"}}:</strong> {{facility.licenseExpires}}</p>
<p>
  <strong>{{translateText "License Status"}}:</strong>
  {{#if facility.isActive}}
    <span class="status-active">{{translateText "Active"}}</span>
  {{else}}
    <span class="status-inactive">{{translateText "Inactive"}}</span>
  {{/if}}
</p>

<p><strong>{{translateText "Licensed Beds"}}:</strong> {{facility.licensedBeds}}</p>
<p><strong>{{translateText "Owner"}}:</strong> {{facility.licensedOwner}}</p>
<p><strong>{{translateText "Admin"}}:</strong> {{facility.adminName}} ({{facility.adminUsername}})</p>

<p>
  <strong>{{translateText "Average Rating"}}:</strong> {{facility.averageRating}} 
  ({{facility.totalReviews}} {{translateText "reviews"}})
</p>

<hr>

<h3>{{translateText "Reviews"}}</h3>
<p>{{translateText "Reviews feature coming soon."}}</p>

<p><a href="/facilities">{{translateText "← Back to facility list"}}</a></p>
