<!DOCTYPE html>
<html id="stuff" lang={{language}}>
  <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>{{translateText title}}</title>
      <link id="contrastRef" rel="stylesheet" href="/public/css/styles.css">
  </head>
  <body>
      <header>
          <h1>{{ translateText title}}</h1>
      </header>
      <main>
          {{{body}}}
          <button class="accessibilityButton" id="contrastToggle">{{translateText "High Contrast Mode"}}</button>
          <form action="/language" method="GET">
            <button type="submit" class="accessibilityButton">Switch to Spanish/Cambiar al Ingl&eacute;s</button>
          </form>
      </main>
    <footer>
        <p class="footerthing">&copy; 2025 HealthRadar NJ. Developed by Group 27.</p>
    </footer>
  </body>
  <script src="/public/js/accessibility.js"></script>
</html>
