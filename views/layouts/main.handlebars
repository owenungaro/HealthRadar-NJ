<!DOCTYPE html>
<html id="stuff" lang="{{language}}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{translateText title}}</title>
    <link id="contrastRef" rel="stylesheet" href="/public/css/styles.css">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
    >
    <link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
    >   

  </head>
  <body>
    <header>
      <h1>{{translateText title}}</h1>
    </header>
    <main>
      {{{body}}}
      <div class="accessibility">
        <button class="accessibilityButton" id="contrastToggle">
          {{translateText "High Contrast Mode"}} </button>
        <form action="/language" method="GET">
          <button type="submit" class="accessibilityButton">Switch to
            Spanish/Cambiar al Ingl&eacute;s</button>
        </form>
      </div>
    </main>
    <footer>
      <p class="footerthing">&copy; 2025 HealthRadar NJ. Developed by Group 27.</p>
    </footer>
  
  <script src="/public/js/accessibility.js"></script>
  <script src="/public/js/starRating.js"></script>
  </body>
</html>