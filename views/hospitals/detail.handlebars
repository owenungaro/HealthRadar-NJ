<div class="facilities-header">
  <h2>{{facility.licensedFacilityName}}</h2>

  {{#if user}}
    <div class="facilities-actions">
      <a href="/dashboard" class="dashboard-link">
        <button class="back-to-dashboard-button">{{translateText
            "Back to Dashboard"
          }}</button>
      </a>

      <form action="/auth/logout" method="POST" class="logout-form">
        <button type="submit" class="logout-button">{{translateText
            "Logout"
          }}</button>
      </form>
    </div>
  {{/if}}
</div>

<section class="facility-info">
  <p><strong>{{translateText "Type"}}:</strong> {{facility.facility_type}}</p>
  <p><strong>{{translateText "Address"}}:</strong>
    {{facility.address}},
    {{facility.city}},
    {{facility.state}}
    {{facility.zipCode}}</p>
  <p><strong>{{translateText "County"}}:</strong> {{facility.county}}</p>
  <p><strong>{{translateText "Phone"}}:</strong> {{facility.telephone}}</p>

  {{#if facility.email}}
    <p><strong>{{translateText "Email"}}:</strong>
      <a href="mailto:{{facility.email}}">{{facility.email}}</a></p>
  {{else}}
    <p><strong>{{translateText "Email"}}:</strong>
      <i>{{translateText "No email available"}}</i></p>
  {{/if}}

  <p><strong>{{translateText "License Expires"}}:</strong>
    {{facility.licenseExpires}}</p>

  <p>
    <strong>{{translateText "Status"}}:</strong>
    {{#if facility.isActive}}
      <span class="status-active">{{translateText "Active"}}</span>
    {{else}}
      <span class="status-inactive">{{translateText "Inactive"}}</span>
    {{/if}}
  </p>

  <p><strong>{{translateText "Licensed Beds"}}:</strong>
    {{facility.licensedBeds}}</p>
  <p><strong>{{translateText "Owner"}}:</strong> {{facility.licensedOwner}}</p>
  <p><strong>{{translateText "Admin"}}:</strong>
    {{facility.adminName}}
    ({{facility.adminUserName}})</p>

  <p>
    <strong>{{translateText "Average Rating"}}:</strong>
    {{#if facility.averageRating}}
      {{facility.averageRating}}%
    {{else}}
      <i>{{translateText "No ratings yet"}}</i>
    {{/if}}
    <span>({{facility.totalReviews}} {{translateText "reviews"}})</span>
  </p>
</section>

<hr />

<h3>{{translateText "Reviews"}}</h3>

<div class="reviews-section">
  {{#if reviewError}}
    <p class="review-error">{{reviewError}}</p>
  {{/if}}

  {{#if reviews.length}}
    {{#each reviews}}
      <div class="review-card">
        <p><strong>{{this.username}}</strong></p>
        <p>
          <strong>{{translateText "Rating"}}:</strong>
          {{#if this.rating}}
            {{this.rating}}
            / 5
          {{else}}
            <i>{{translateText "No rating provided"}}</i>
          {{/if}}
        </p>
        <p>{{this.review}}</p>
        <p><i>{{this.dateFormatted}}</i></p>
      </div>
      <hr />
    {{/each}}

  {{else}}
    <p><i>{{translateText
          "No reviews yet. Be the first to review this facility!"
        }}</i></p>
  {{/if}}

  <hr />

  <h3>{{translateText "Leave a Review"}}</h3>

  {{#if user}}
    <form
      action="/facilities/{{facility._id}}"
      method="POST"
      class="review-form"
    >

      <h4>{{translateText "Your Rating"}}</h4>
      <div class="star-rating">
        <input type="hidden" name="rating" id="rating-input" value="0" />

        <span class="star" data-star="1">&#9733;</span>
        <span class="star" data-star="2">&#9733;</span>
        <span class="star" data-star="3">&#9733;</span>
        <span class="star" data-star="4">&#9733;</span>
        <span class="star" data-star="5">&#9733;</span>

        <span class="star-rating-value" id="rating-value">0 / 5</span>
      </div>

      <textarea
        name="reviewText"
        placeholder="Write your review..."
        minlength="5"
        maxlength="500"
        required
        rows="3"
        style="width:100%; resize:vertical;"
      ></textarea>

      <br />
      <button type="submit" class="review-submit-btn">{{translateText
          "Submit Review"
        }}</button>

    </form>
  {{else}}
    <p><i>{{translateText "You must be logged in to leave a review."}}</i></p>
  {{/if}}

</div>

<br />
<p><a href="/facilities">{{translateText "← Back to facility list"}}</a></p>