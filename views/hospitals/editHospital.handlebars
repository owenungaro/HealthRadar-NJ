<div class="signup-container">
  <h2>Edit Facility: {{facility.licensedFacilityName}}</h2>

  {{#if error}}
  <div class="error-box">
    <ul>
      <li>{{error}}</li>
    </ul>
  </div>
  {{/if}}

  <form action="/facilities/{{facility._id}}/edit" method="POST" class="signup-form">

    <div class="form-group">
      <label>Type</label>
      <input type="text" name="facility_type" value="{{facility.facility_type}}" required>
    </div>

    <div class="form-group">
      <label>License Number</label>
      <input type="text" name="licenseNumber" value="{{facility.licenseNumber}}" required>
    </div>

    <div class="form-group">
      <label>Licensed Facility Name</label>
      <input type="text" name="licensedFacilityName" value="{{facility.licensedFacilityName}}" required>
    </div>

    <div class="form-group">
      <label>Address</label>
      <input type="text" name="address" value="{{facility.address}}" required>
    </div>

    <div class="form-group">
      <label>City</label>
      <input type="text" name="city" value="{{facility.city}}" required>
    </div>

    <div class="form-group">
      <label>State</label>
      <input type="text" name="state" value="{{facility.state}}" required>
    </div>

    <div class="form-group">
      <label>Zip Code</label>
      <input type="text" name="zipCode" value="{{facility.zipCode}}" required>
    </div>

    <div class="form-group">
      <label>County</label>
      <input type="text" name="county" value="{{facility.county}}" required>
    </div>

    <div class="form-group">
      <label>Telephone</label>
      <input type="text" name="telephone" value="{{facility.telephone}}" required>
    </div>

    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" value="{{facility.email}}">
    </div>

    <div class="form-group">
      <label>License Expires</label>
      <input type="date" name="licenseExpires" value="{{facility.licenseExpiresFormatted}}" required>
    </div>

    <div class="form-group">
      <label>Admin Name</label>
      <input type="text" name="adminName" value="{{facility.adminName}}">
    </div>

    <div class="form-group">
      <label>Owner</label>
      <input type="text" name="licensedOwner" value="{{facility.licensedOwner}}" required>
    </div>

    <div class="form-group">
      <label>Latitude</label>
      <input type="number" step="any" name="latitude" value="{{facility.latitude}}" required>
    </div>

    <div class="form-group">
      <label>Longitude</label>
      <input type="number" step="any" name="longitude" value="{{facility.longitude}}" required>
    </div>

    <div class="form-group">
      <label>Status</label>
      <select name="isActive">
        <option value="true" {{#if facility.isActive}}selected{{/if}}>Active</option>
        <option value="false" {{#unless facility.isActive}}selected{{/unless}}>Inactive</option>
      </select>
    </div>

    <button type="submit">Save Changes</button>
  </form>
</div>
