<header class="dashboard-header">
  <h1>{{translateText "Welcome to Emergency Locator"}}</h1>
  {{#if user}}
    <div class="facilities-actions">
      <a href="/dashboard" class="dashboard-link">
        <button class="back-to-dashboard-button">{{translateText "Back to Dashboard"}}</button>
      </a>

      <form action="/auth/logout" method="POST" class="logout-form">
        <button type="submit" class="logout-button">{{translateText "Logout"}}</button>
      </form>
    </div>
  {{/if}}
</header>

<div class="logo-container">
  <img src="/public/images/healthradar_logo.svg" alt="HealthRadar Logo" class="logo">
</div>

<main class="emergency-locator-main">
  <section class="emergency-locator-panel">
    <h2>{{translateText "Find Your Nearest Emergency Center"}}</h2>
    <p>
      {{translateText "Click the button below to use your current location and find nearby emergency centers."}}
    </p>

    <button id="find-emergency-btn" class="logout-button">
      {{translateText "Use My Location"}}
    </button>

    <p id="emergency-status" class="emergency-status-text"></p>

    <div id="nearest-emergency-result" class="facility-list-container">
    </div>
  </section>
</main>

<script src="/public/js/emergencyLocator.js"></script>
