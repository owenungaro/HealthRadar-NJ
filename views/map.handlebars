<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>

    <link
      rel="stylesheet" 
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
    <link rel="stylesheet" href="/public/css/styles.css">
</head>

<body>
  <div class="map-header">
    
    <a href="/dashboard">
      <button class="back-to-dashboard-button">Back to Dashboard</button>
    </a>
    
  </div>
    <div class="logo-container">
  <img src="/public/images/healthradar_logo.svg" alt="HealthRadar Logo" class="logo">
</div>

  <div id="map"></div>

  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>

  <script>
    const hospitalData = {{{json hospitals}}};
    
    console.log("Hospital data loaded:", hospitalData); 

    if (!hospitalData || hospitalData.length === 0) {
      alert("No hospital data available to display on map.");
    }

    const map = L.map('map').setView([40.0583, -74.4057], 8);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    let markersAdded = 0;
    hospitalData.forEach(h => {
      if (!h.latitude || !h.longitude) {
        console.warn("Skipping hospital without coordinates:", h.licensedFacilityName);
        return;
      }

      const marker = L.marker([h.latitude, h.longitude]).addTo(map);
      markersAdded++;

      marker.bindPopup(`
        <div style="min-width: 200px;">
          <strong>${h.licensedFacilityName}</strong><br>
          ${h.address}, ${h.city}, NJ ${h.zipCode}<br>
          <strong>Type:</strong> ${h.facility_type}<br>
          <strong>Status:</strong> ${h.isActive ? "Active" : "Inactive"}<br><br>
          <a href="/facilities/${h._id}" style="text-decoration: none;">
            <button style="padding: 5px 10px; background: #007bff; color: white; border: none; border-radius: 3px; cursor: pointer;">
              View Details
            </button>
          </a>
        </div>
      `);
    });

    console.log("Markers added to map:", markersAdded);
  </script>
</body>
</html>